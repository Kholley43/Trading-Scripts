# ============================================
# StreamCleanup.ps1
# Run this ONCE as Administrator to install.
# After that it runs automatically on schedule.
# ============================================
# Change $IntervalMinutes to adjust frequency
# ============================================

$IntervalMinutes = 45
$TaskName   = "StreamMemoryCleanup"
$ScriptPath = $MyInvocation.MyCommand.Path
$LogFile    = "$PSScriptRoot\StreamCleanup.log"

function Log($msg) {
    $line = "[$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')] $msg"
    Write-Host $line
    Add-Content -Path $LogFile -Value $line
}

# ── FIRST RUN: Register scheduled task then exit ─────────────────────────────
$existingTask = Get-ScheduledTask -TaskName $TaskName -ErrorAction SilentlyContinue

if (-not $existingTask) {
    if (-not ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole(
        [Security.Principal.WindowsBuiltInRole]::Administrator)) {
        Write-Host "ERROR: Please run as Administrator the first time to install the scheduled task." -ForegroundColor Red
        pause
        exit
    }

    $Action    = New-ScheduledTaskAction `
        -Execute "powershell.exe" `
        -Argument "-NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -File `"$ScriptPath`""

    $Trigger   = New-ScheduledTaskTrigger -RepetitionInterval (New-TimeSpan -Minutes $IntervalMinutes) -Once -At (Get-Date)
    $Principal = New-ScheduledTaskPrincipal -UserId "SYSTEM" -LogonType ServiceAccount -RunLevel Highest
    $Settings  = New-ScheduledTaskSettingsSet `
        -ExecutionTimeLimit (New-TimeSpan -Minutes 5) `
        -MultipleInstances IgnoreNew `
        -StartWhenAvailable

    Register-ScheduledTask `
        -TaskName   $TaskName `
        -Action     $Action `
        -Trigger    $Trigger `
        -Principal  $Principal `
        -Settings   $Settings `
        -Description "Clears temp/cache/standby memory every $IntervalMinutes mins. Protects Tape Surf, NinjaTrader and OBS." | Out-Null

    Write-Host "Task '$TaskName' installed. Runs every $IntervalMinutes minutes automatically." -ForegroundColor Green
    Write-Host "Log file: $LogFile" -ForegroundColor Cyan
    pause
    exit
}

# ── SCHEDULED RUNS: Cleanup logic ────────────────────────────────────────────
Log "--- Cleanup started ---"

# 1. Windows Temp folders
foreach ($path in @($env:TEMP, $env:TMP, "C:\Windows\Temp")) {
    if (Test-Path $path) {
        $before = (Get-ChildItem $path -Recurse -ErrorAction SilentlyContinue | Measure-Object -Property Length -Sum).Sum
        Get-ChildItem $path -Recurse -ErrorAction SilentlyContinue |
            Where-Object { !$_.PSIsContainer } |
            Remove-Item -Force -ErrorAction SilentlyContinue
        $freed = [math]::Round(($before - (Get-ChildItem $path -Recurse -ErrorAction SilentlyContinue | Measure-Object -Property Length -Sum).Sum) / 1MB, 2)
        Log "Temp cleared: $path (+$freed MB freed)"
    }
}

# 2. DNS cache
ipconfig /flushdns | Out-Null
Log "DNS cache flushed"

# 3. Prefetch
if (Test-Path "C:\Windows\Prefetch") {
    Remove-Item "C:\Windows\Prefetch\*" -Force -ErrorAction SilentlyContinue
    Log "Prefetch cleared"
}

# 4. Opera cache
$operaCache = "$env:APPDATA\Opera Software\Opera Stable\Cache\Cache_Data"
if (Test-Path $operaCache) {
    $before = (Get-ChildItem $operaCache -Recurse -ErrorAction SilentlyContinue | Measure-Object -Property Length -Sum).Sum
    Remove-Item "$operaCache\*" -Force -Recurse -ErrorAction SilentlyContinue
    Log "Opera cache cleared (+$([math]::Round($before / 1MB, 2)) MB freed)"
}

# 5. Delivery Optimisation cache
$doCache = "C:\Windows\SoftwareDistribution\DeliveryOptimization\Cache"
if (Test-Path $doCache) {
    Remove-Item "$doCache\*" -Force -Recurse -ErrorAction SilentlyContinue
    Log "Delivery Optimisation cache cleared"
}

# 6. Recycle Bin
Clear-RecycleBin -Force -ErrorAction SilentlyContinue
Log "Recycle Bin emptied"

# 7. Standby memory flush (skips Tape Surf, Ninja, OBS)
$code = @"
using System;
using System.Runtime.InteropServices;
public class MemHelper {
    [DllImport("psapi.dll")] public static extern bool EmptyWorkingSet(IntPtr hProcess);
}
"@
Add-Type -TypeDefinition $code -ErrorAction SilentlyContinue
$protected = @("NinjaTrader","TapeSurf","OBS","obs64","opera")
foreach ($proc in (Get-Process -ErrorAction SilentlyContinue | Where-Object { $_.Name -notin $protected })) {
    try { [MemHelper]::EmptyWorkingSet($proc.Handle) | Out-Null } catch {}
}
Log "Standby memory flushed (Tape Surf / Ninja / OBS protected)"

# 8. .NET GC
[System.GC]::Collect()
[System.GC]::WaitForPendingFinalizers()
Log "GC collect triggered"

Log "--- Cleanup complete ---"
Log ""
